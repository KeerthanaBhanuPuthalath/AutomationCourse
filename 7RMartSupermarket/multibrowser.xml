<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Multibrowser Testing" parallel="tests" thread-count="5">
	<test name="Test1">
		<parameter name="browsers" value="chrome"></parameter>
		<classes>
			<class name="testScripts.ManageNewsTest">
				<methods>
					<exclude name="verifyWhetherUserAbleToAddNewsAndSave"></exclude>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->
	<test name="Test2">
		<parameter name="browsers" value="edge"></parameter>
		<classes>
			<class name="testScripts.LoginTest">
				<methods>
					<exclude name="verifyUserLoginWithValidCredentials"></exclude>
				</methods>
			</class>
		</classes>
	</test>
</suite> <!--
Suite -->
